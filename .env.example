# Copy to .env (git-ignored) and adjust. Every variable is validated at startup.
NODE_ENV=development
LOG_LEVEL=debug

# API
PORT=4000

# Postgres (matches infra/docker-compose.yml)
DATABASE_URL=postgres://bmt:bmt@localhost:5432/bmt
DATABASE_POOL_MAX=10

# Redis (matches infra/docker-compose.yml)
REDIS_URL=redis://localhost:6379

# Auth (Better Auth). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-replace-me-with-openssl-output
BETTER_AUTH_URL=http://localhost:4000
# Browser origins allowed to call the API, comma-separated (the Next.js app in M6)
WEB_ORIGINS=http://localhost:3000

# Used only by `make create-admin`
ADMIN_EMAIL=admin@bmt.local
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Admin

# Bookings: how long held seats stay reserved, and the most seats in one booking
HOLD_TTL_SECONDS=300
MAX_SEATS_PER_BOOKING=5
# How seats are taken: redis (default), conditional or pessimistic. See docs/adr/0005.
HOLD_STRATEGY=redis

# Worker: hold expiry (docs/adr/0006). Jobs run at once per worker, and how often /
# how many the sweeper releases when a hold's job was lost.
HOLD_EXPIRY_CONCURRENCY=10
HOLD_SWEEP_INTERVAL_MS=30000
HOLD_SWEEP_BATCH_SIZE=500
# Worker: email. smtp sends to Mailpit (inbox at http://localhost:8025); resend needs RESEND_API_KEY
MAILER=smtp
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=
EMAIL_FROM=BookMyTicket <tickets@bmt.local>
# Worker: how often the outbox relay looks for committed events (ADR 0008)
OUTBOX_RELAY_INTERVAL_MS=500
# Worker: refunds still PENDING are re-queued, and unconfirmed orders checked with Razorpay (ADR 0007)
REFUND_SWEEP_INTERVAL_MS=300000
RECONCILE_INTERVAL_MS=120000

# Razorpay test keys (Dashboard → Test Mode → Account & Settings → API Keys).
# Leave empty to run without payments; the payment endpoints then answer 503.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you set on the webhook in the Razorpay Dashboard (openssl rand -hex 32)
RAZORPAY_WEBHOOK_SECRET=

# How long a process waits for in-flight work on SIGTERM before forcing exit
SHUTDOWN_TIMEOUT_MS=10000
