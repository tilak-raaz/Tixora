# Copy to .env (git-ignored) and adjust. Every variable is validated at startup.
NODE_ENV=development
LOG_LEVEL=debug

# API
PORT=4000

# Postgres (matches infra/docker-compose.yml)
DATABASE_URL=postgres://bmt:bmt@localhost:5432/bmt
DATABASE_POOL_MAX=10

# Redis (matches infra/docker-compose.yml)
REDIS_URL=redis://localhost:6379

# Auth (Better Auth). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-replace-me-with-openssl-output
BETTER_AUTH_URL=http://localhost:4000
# Browser origins allowed to call the API, comma-separated (the Next.js app in M6)
WEB_ORIGINS=http://localhost:3000

# Used only by `make create-admin`
ADMIN_EMAIL=admin@bmt.local
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Admin

# Bookings: how long held seats stay reserved, and the most seats in one booking
HOLD_TTL_SECONDS=300
MAX_SEATS_PER_BOOKING=5
# How seats are taken: redis (default), conditional or pessimistic. See docs/adr/0005.
HOLD_STRATEGY=redis

# Worker: hold expiry (docs/adr/0006). Jobs run at once per worker, and how often /
# how many the sweeper releases when a hold's job was lost.
HOLD_EXPIRY_CONCURRENCY=10
HOLD_SWEEP_INTERVAL_MS=30000
HOLD_SWEEP_BATCH_SIZE=500

# How long a process waits for in-flight work on SIGTERM before forcing exit
SHUTDOWN_TIMEOUT_MS=10000
