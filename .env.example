# Copy to .env (git-ignored) and adjust. Every variable is validated at startup.
NODE_ENV=development
LOG_LEVEL=debug

# API
PORT=4000

# Postgres (matches infra/docker-compose.yml)
DATABASE_URL=postgres://bmt:bmt@localhost:5432/bmt
DATABASE_POOL_MAX=10

# Redis (matches infra/docker-compose.yml)
REDIS_URL=redis://localhost:6379

# How long a process waits for in-flight work on SIGTERM before forcing exit
SHUTDOWN_TIMEOUT_MS=10000
