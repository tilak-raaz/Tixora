# Production settings for infra/deploy/docker-compose.yml. Copy to .env on the server
# (cp .env.example .env) and fill in. .env is git-ignored and must never be committed.

# The public address, and the email Let's Encrypt writes to about the certificate.
DOMAIN=tixora.tilakraaz.cloud
ACME_EMAIL=

# The release to run; ./tixora.sh deploy <tag> sets it for that run.
TAG=latest

# How many of each to run. 3 and 2 match what the load tests measured; on a 2 GB server, 2 and 1
# leave more memory free.
API_REPLICAS=3
WORKER_REPLICAS=2

LOG_LEVEL=info

# Generate each with: openssl rand -base64 32
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=

# Email through Resend (https://resend.com), from an address on a domain verified there.
RESEND_API_KEY=
EMAIL_FROM=Tixora <tickets@tilakraaz.cloud>

# Razorpay test-mode keys, and the secret set on the webhook pointing at
# https://<DOMAIN>/webhooks/razorpay. Empty: payment endpoints answer 503.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
