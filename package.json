{
  "name": "book-my-ticket",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Movie ticket booking platform built to explore distributed-systems patterns",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @bmt/api",
    "dev:worker": "npm run dev -w @bmt/worker",
    "dev:web": "npm run dev -w @bmt/web",
    "build:web": "npm run build -w @bmt/web",
    "migrate": "npm run migrate -w @bmt/api",
    "create-admin": "npm run create-admin -w @bmt/api",
    "seed": "npm run seed -w @bmt/api",
    "bench": "npm run bench -w @bmt/api",
    "replay-dlq": "npm run replay-dlq -w @bmt/worker --",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.39.0",
    "@next/eslint-plugin-next": "^16.1.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.0"
  }
}
